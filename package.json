{
  "name": "@dsh-external/dsh-artifact-library",
  "description": "DSH 产物库 + 本地文件管理器：登记/管理/检索 DSH 产出物，提供毫秒级本地文件搜索（索引范围严格限定在工作区与已登记目录）。Windows 用内置 Everything，Linux 用纯 Node 范围索引，查询语法与界面一致。Artifact library and local file manager for DeepSeek Harness.",
  "version": "0.9.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "artifact-library",
    "file-manager",
    "everything",
    "local-search",
    "cross-platform",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyq183/dsh-artifact-library.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "ui",
    "vendor",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "license": "MIT"
}
